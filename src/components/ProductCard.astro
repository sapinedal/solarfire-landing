---
// ProductCard.astro
import { Image } from "astro:assets";
import type { Product } from "../data/products";
import { whatsappLink, productQuoteMessage } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const cover = product.images[0];
---

<article
  class="product-card group flex flex-col bg-white rounded-3xl border border-cream-dark overflow-hidden hover:shadow-2xl hover:shadow-brand-blue/10 hover:-translate-y-1 transition-all duration-300"
  data-categories={product.categories.join("|")}
>
  <button
    type="button"
    class="relative block aspect-[4/5] bg-white overflow-hidden cursor-zoom-in"
    data-open-product={product.slug}
    aria-label={`Ver ficha de ${product.name}`}
  >
    <div class="absolute inset-x-8 bottom-6 top-1/3 sun-glow opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
    <Image
      src={cover.src}
      alt={cover.alt}
      widths={[320, 480, 640]}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
      class="relative w-full h-full object-contain p-6 mix-blend-multiply group-hover:scale-[1.04] transition-transform duration-500"
    />
    {product.images.length > 1 && (
      <span class="absolute top-4 right-4 px-2.5 py-1 rounded-full bg-cream text-[11px] font-semibold text-slate-600">
        {product.images.length} fotos
      </span>
    )}
  </button>

  <div class="flex flex-col flex-1 p-6 pt-5 border-t border-cream-dark">
    <ul class="flex flex-wrap gap-1.5 mb-3" aria-label="Categorías">
      {product.categories.map((c) => (
        <li class="px-2.5 py-0.5 rounded-full bg-brand-blue-light text-brand-blue text-[11px] font-semibold">{c}</li>
      ))}
    </ul>
    <h3 class="font-display font-bold text-xl text-ink leading-tight">{product.name}</h3>
    <p class="mt-2 text-sm text-slate-600 leading-relaxed">{product.tagline}</p>

    {product.variants && (
      <p class="mt-4 text-xs text-slate-500">
        <span class="font-semibold text-slate-700">{product.variants.label}:</span>{" "}
        {product.variants.items.slice(0, 3).join(" · ")}
        {product.variants.items.length > 3 && ` +${product.variants.items.length - 3}`}
      </p>
    )}

    <div class="mt-auto pt-6 flex items-center gap-2">
      <button
        type="button"
        data-open-product={product.slug}
        class="flex-1 px-4 py-3 rounded-xl bg-cream hover:bg-cream-dark text-ink text-sm font-semibold transition-colors"
      >
        Ver ficha
      </button>
      <a
        href={whatsappLink(productQuoteMessage(product))}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-3 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white text-sm font-semibold transition-colors"
      >
        Cotizar
      </a>
    </div>
  </div>
</article>
