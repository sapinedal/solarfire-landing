---
// InvimaBadge.astro
import invimaLogo from "../assets/logo-invima.png";
---

<section id="nosotros" class="py-20 bg-slate-50 relative overflow-hidden">
  <!-- Decorative background shapes -->
  <div
    class="absolute top-1/2 left-1/3 w-96 h-96 bg-brand-blue/5 rounded-full blur-3xl pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-10 right-10 w-72 h-72 bg-brand-yellow/10 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="lg:grid lg:grid-cols-12 lg:gap-16 items-center">
      <!-- Text content -->
      <div class="lg:col-span-7 space-y-6">
        <div
          class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-brand-blue-light border border-brand-blue/15 text-brand-blue font-semibold text-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"
            ></path>
          </svg>
          <span>Certificación Oficial Colombiana</span>
        </div>

        <h2
          class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-brand-blue tracking-tight leading-none"
        >
          Calidad Certificada por el <span class="text-gradient-fire"
            >INVIMA</span
          >
        </h2>

        <p class="text-lg text-slate-600 leading-relaxed">
          En <strong class="font-semibold text-brand-blue"
            >Solar Fire S.A.S.</strong
          >, fabricamos cada producto bajo estrictas normas de control de
          calidad e higiene. Contamos con el concepto sanitario favorable y
          registros <strong class="font-semibold text-brand-blue">INVIMA</strong
          > de capacidad de producción, asegurando que todos nuestros desinfectantes,
          jabones y detergentes son altamente efectivos, seguros para la salud y cumplen
          con la normatividad nacional.
        </p>

        <!-- Feature checkboxes -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
          <div class="flex items-start space-x-3">
            <div
              class="shrink-0 w-6 h-6 rounded-full bg-brand-yellow/20 flex items-center justify-center text-brand-orange"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="w-4 h-4"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-800">
                Ubicación Estratégica
              </h4>
              <p class="text-slate-500 text-sm">
                Planta de producción en Itagüí - Antioquia, listos para
                despachos nacionales.
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-3">
            <div
              class="shrink-0 w-6 h-6 rounded-full bg-brand-yellow/20 flex items-center justify-center text-brand-orange"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="w-4 h-4"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-800">
                Fórmulas Biodegradables
              </h4>
              <p class="text-slate-500 text-sm">
                Comprometidos con el medio ambiente utilizando tensoactivos
                amigables.
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-3">
            <div
              class="shrink-0 w-6 h-6 rounded-full bg-brand-yellow/20 flex items-center justify-center text-brand-orange"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="w-4 h-4"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-800">
                Desinfección de Alto Espectro
              </h4>
              <p class="text-slate-500 text-sm">
                Productos efectivos contra bacterias, hongos y virus.
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-3">
            <div
              class="shrink-0 w-6 h-6 rounded-full bg-brand-yellow/20 flex items-center justify-center text-brand-orange"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="w-4 h-4"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-800">
                Venta Mayorista y Detal
              </h4>
              <p class="text-slate-500 text-sm">
                Suministros directos para empresas, colegios, conjuntos y
                hogares.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Trust graphic / Badge -->
      <div class="mt-12 lg:mt-0 lg:col-span-5 flex justify-center">
        <div class="relative group">
          <!-- Outer decorative rings with shine effect -->
          <div
            class="absolute inset-0 bg-linear-to-tr from-brand-red/5 via-brand-orange/5 to-brand-yellow/10 rounded-3xl blur-2xl opacity-60 group-hover:opacity-85 transition-opacity duration-500"
          >
          </div>

          <div
            class="relative bg-white rounded-3xl p-8 border border-slate-100 text-slate-800 w-full max-w-sm flex flex-col items-center text-center shadow-xl"
          >
            <!-- Seal Badge Emblem -->
            <div
              class="w-28 h-28 rounded-full bg-white p-4 shadow-md flex items-center justify-center mb-6 border border-slate-100 relative"
            >
              <img
                src={invimaLogo.src}
                alt="Logo INVIMA"
                class="w-full h-auto object-contain"
              />
            </div>

            <h3 class="font-display font-bold text-xl text-brand-blue">
              Concepto Sanitario
            </h3>
            <p class="text-slate-600 text-sm mt-2 font-light">
              Certificación de Condiciones Sanitarias y Capacidad de Fabricación
              para productos de higiene doméstica e industrial.
            </p>

            <div class="w-full border-t border-slate-100 my-6"></div>

            <div
              class="flex items-center space-x-3 bg-slate-50 px-4 py-2.5 rounded-xl border border-slate-200/50"
            >
              <!-- Colombian Flag mini representation -->
              <div class="flex flex-col w-6 h-4 rounded overflow-hidden">
                <div class="h-2 bg-yellow-400"></div>
                <div class="h-1 bg-blue-700"></div>
                <div class="h-1 bg-red-600"></div>
              </div>
              <span
                class="text-xs font-semibold text-slate-600 tracking-wider uppercase"
                >Hecho en Colombia</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
