---
// InvimaBadge.astro — Nosotros, confianza y línea BIO
import { Image } from "astro:assets";
import RichText from "./RichText.astro";
import { getPagina } from "../lib/contenido";
import { iconoPath } from "../lib/iconos";

const seccion = await getPagina("nosotros");
const pillars = seccion.pillars.map((p) => ({ ...p, icon: iconoPath(p.icon) }));
---

<section id="nosotros" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 items-start">
      <div class="reveal lg:col-span-5 lg:sticky lg:top-32">
        <p class="eyebrow">{seccion.eyebrow}</p>
        <h2 class="mt-3 font-display font-extrabold text-4xl md:text-5xl text-brand-blue tracking-tight leading-[1.05]">
          {seccion.title}
        </h2>
        <p class="mt-5 text-lg text-slate-600 leading-relaxed">
          <RichText text={seccion.description} />
        </p>
        <div class="mt-8 inline-flex items-center gap-4 rounded-2xl border border-cream-dark bg-cream p-4 pr-6">
          <Image src={seccion.badgeLogo} alt="" width={160} class="h-12 w-auto" />
          <div class="text-sm leading-tight">
            <p class="font-semibold text-ink">{seccion.badgeTitle}</p>
            <p class="text-slate-500">{seccion.badgeSubtitle}</p>
          </div>
        </div>
      </div>

      <ul class="lg:col-span-7 grid sm:grid-cols-2 gap-4">
        {pillars.map((p) => (
          <li class="reveal rounded-3xl bg-cream p-7 border border-cream-dark">
            <span class="inline-flex w-12 h-12 items-center justify-center rounded-2xl bg-white text-brand-orange shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
              </svg>
            </span>
            <h3 class="mt-5 font-display font-bold text-xl text-ink">{p.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Línea BIO banner -->
    <figure class="reveal mt-20 rounded-[2rem] overflow-hidden border border-cream-dark shadow-xl shadow-brand-blue/5">
      <Image
        src={seccion.banner}
        alt={seccion.bannerAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1280px) 1216px, 94vw"
        class="w-full h-auto"
      />
    </figure>
  </div>
</section>
