---
// ContactForm.astro — el formulario arma el mensaje y lo abre en WhatsApp
import { products, whatsappLink } from "../data/products";

const contactItems = [
  {
    title: "Nuestra planta",
    lines: ["Carrera 45 A # 67 B - 109", "Itagüí, Antioquia, Colombia"],
    icon: "M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z",
  },
  {
    title: "Líneas de atención",
    lines: ["Celular / WhatsApp: +57 302 371 6599", "Fijo: (604) 374 8132"],
    icon: "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.184-4.162-6.986-6.986l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z",
  },
  {
    title: "Correo electrónico",
    lines: ["solarfireproductos@gmail.com"],
    href: "mailto:solarfireproductos@gmail.com",
    icon: "M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75",
  },
];

const inputClass =
  "w-full px-4 py-3 rounded-xl border border-cream-dark bg-cream/50 focus:bg-white focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 outline-none transition text-ink placeholder:text-slate-400";
---

<section id="contacto" class="py-20 md:py-28 bg-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Info -->
      <div class="reveal lg:col-span-5">
        <p class="eyebrow">Contacto</p>
        <h2 class="mt-3 font-display font-extrabold text-4xl md:text-5xl text-brand-blue tracking-tight leading-[1.05]">
          Cotiza con nosotros
        </h2>
        <p class="mt-5 text-lg text-slate-600 leading-relaxed">
          ¿Necesitas productos para tu empresa, conjunto residencial o negocio? Escríbenos y te asesoramos con
          precios de fábrica y fichas técnicas.
        </p>

        <ul class="mt-10 space-y-6">
          {contactItems.map((c) => (
            <li class="flex gap-4">
              <span class="w-11 h-11 shrink-0 rounded-xl bg-white border border-cream-dark flex items-center justify-center text-brand-orange">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={c.icon} />
                </svg>
              </span>
              <div>
                <h3 class="font-semibold text-ink">{c.title}</h3>
                {c.lines.map((l) =>
                  c.href ? (
                    <a href={c.href} class="block text-slate-600 text-sm hover:text-brand-blue underline-offset-2 hover:underline">{l}</a>
                  ) : (
                    <p class="text-slate-600 text-sm">{l}</p>
                  ),
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Form -->
      <div class="reveal lg:col-span-7 bg-white rounded-[2rem] p-6 sm:p-10 border border-cream-dark shadow-xl shadow-brand-blue/5">
        <form id="contact-form" class="space-y-5" novalidate>
          <div class="grid sm:grid-cols-2 gap-5">
            <div class="space-y-2">
              <label for="name" class="block text-sm font-semibold text-ink">Nombre</label>
              <input type="text" id="name" name="name" required autocomplete="name" class={inputClass} placeholder="Tu nombre" />
            </div>
            <div class="space-y-2">
              <label for="company" class="block text-sm font-semibold text-ink">
                Empresa <span class="font-normal text-slate-400">(opcional)</span>
              </label>
              <input type="text" id="company" name="company" autocomplete="organization" class={inputClass} placeholder="Nombre de tu empresa" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div class="space-y-2">
              <label for="city" class="block text-sm font-semibold text-ink">Ciudad</label>
              <input type="text" id="city" name="city" autocomplete="address-level2" class={inputClass} placeholder="Ej. Medellín" />
            </div>
            <div class="space-y-2">
              <label for="product" class="block text-sm font-semibold text-ink">Producto de interés</label>
              <select id="product" name="product" class={inputClass}>
                <option value="">Varios / no estoy seguro</option>
                {products.map((p) => <option value={p.name}>{p.name}</option>)}
                <option value="Línea RUDO">Línea RUDO</option>
                <option value="Quiero ser distribuidor">Quiero ser distribuidor</option>
              </select>
            </div>
          </div>

          <div class="space-y-2">
            <label for="message" class="block text-sm font-semibold text-ink">¿Qué necesitas?</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class={`${inputClass} resize-none`}
              placeholder="Productos, presentaciones y cantidades aproximadas…"></textarea>
          </div>

          <p id="form-error" class="hidden text-sm text-brand-red" role="alert">
            Por favor escribe tu nombre y lo que necesitas.
          </p>

          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 py-4 rounded-2xl bg-brand-red hover:bg-brand-red-dark text-white font-semibold transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.39-4.19-1.15l-.3-.17-3.12.82.83-3.04-.2-.32a8.19 8.19 0 0 1-1.26-4.38c.01-4.54 3.7-8.24 8.25-8.24" />
            </svg>
            Enviar solicitud por WhatsApp
          </button>
          <p class="text-xs text-center text-slate-500">
            Se abrirá WhatsApp con tu mensaje listo para enviar. Respondemos en horario laboral.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { whatsappLink } from "../data/products";

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const error = document.getElementById("form-error");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? "").trim();
    const name = get("name");
    const message = get("message");

    if (!name || !message) {
      error?.classList.remove("hidden");
      return;
    }
    error?.classList.add("hidden");

    const lines = [
      `Hola Solar Fire, mi nombre es ${name}${get("company") ? ` de ${get("company")}` : ""}.`,
      get("city") && `Ciudad: ${get("city")}`,
      get("product") && `Producto de interés: ${get("product")}`,
      `Mensaje: ${message}`,
    ].filter(Boolean);

    window.open(whatsappLink(lines.join("\n")), "_blank", "noopener");
  });
</script>
