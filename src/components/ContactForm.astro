---
// ContactForm.astro
---

<section id="contacto" class="py-24 bg-slate-50 relative overflow-hidden">
  <div
    class="absolute top-1/2 right-1/4 w-80 h-80 bg-brand-yellow/10 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      <!-- Contact Info Panel (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <div
            class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-brand-blue-light border border-brand-blue/15 text-brand-blue font-bold text-xs tracking-wider uppercase"
          >
            <span>¿Tienes preguntas?</span>
          </div>
          <h2
            class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-brand-blue tracking-tight leading-none"
          >
            Ponte en <span class="text-gradient-fire">Contacto</span>
          </h2>
          <p class="text-slate-600 text-base leading-relaxed">
            ¿Necesitas una cotización para tu empresa, conjunto residencial o
            negocio? Escríbenos o visítanos. Brindamos asesoría personalizada y
            fichas técnicas completas.
          </p>
        </div>

        <!-- Contact Information Cards -->
        <div class="space-y-4">
          <!-- Address -->
          <div
            class="flex items-start space-x-4 p-5 rounded-2xl bg-white border border-slate-100 shadow-sm"
          >
            <div
              class="w-12 h-12 rounded-xl bg-brand-blue/10 flex items-center justify-center text-brand-blue shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-6 h-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                ></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-800">Nuestra Planta</h4>
              <p class="text-slate-500 text-sm mt-1">
                Carrera 45 A # 67 B - 109, Itagüí, Antioquia, Colombia
              </p>
            </div>
          </div>

          <!-- Phone -->
          <div
            class="flex items-start space-x-4 p-5 rounded-2xl bg-white border border-slate-100 shadow-sm"
          >
            <div
              class="w-12 h-12 rounded-xl bg-brand-orange/10 flex items-center justify-center text-brand-orange shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-6 h-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.184-4.162-6.986-6.986l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                ></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-800">Líneas de Atención</h4>
              <p class="text-slate-500 text-sm mt-1">
                Celular/WhatsApp: +57 302 371 6599
              </p>
              <p class="text-slate-500 text-sm">Fijo: (604) 374 8132</p>
            </div>
          </div>

          <!-- Email -->
          <div
            class="flex items-start space-x-4 p-5 rounded-2xl bg-white border border-slate-100 shadow-sm"
          >
            <div
              class="w-12 h-12 rounded-xl bg-brand-yellow/20 flex items-center justify-center text-brand-orange shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-6 h-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                ></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-800">Correo Electrónico</h4>
              <p class="text-slate-500 text-sm mt-1">
                solarfireproductos@gmail.com
              </p>
            </div>
          </div>
        </div>

        <!-- WhatsApp Quick Chat Button -->
        <a
          href="https://wa.me/573023716599?text=Hola%20Solar%20Fire,%20vengo%20de%20la%20página%20web%20y%20quiero%20hacer%20una%20consulta%20comercial."
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center space-x-3 w-full py-4 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-2xl transition-all duration-300 shadow-lg shadow-emerald-500/10 hover:shadow-emerald-500/30 hover:-translate-y-0.5"
        >
          <!-- WhatsApp Icon -->
          <svg
            class="h-7 w-7"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"
            ></path>
          </svg>
          <span>Chat Directo por WhatsApp</span>
        </a>
      </div>

      <!-- Interactive Form Panel (7 cols) -->
      <div
        class="lg:col-span-7 bg-white rounded-3xl p-8 border border-slate-100 shadow-xl relative min-h-[500px]"
      >
        <!-- Form View -->
        <form
          id="contact-form"
          class="space-y-6 transition-opacity duration-300"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Name Input -->
            <div class="space-y-2 relative">
              <label
                for="name"
                class="block text-sm font-semibold text-slate-700"
                >Nombre Completo</label
              >
              <input
                type="text"
                id="name"
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/15 outline-none transition-all text-slate-800"
                placeholder="Ej. Juan Pérez"
              />
              <span
                class="validation-icon hidden absolute right-3 top-9 text-emerald-500"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  stroke="currentColor"
                  class="w-5 h-5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296"
                  ></path>
                </svg>
              </span>
            </div>

            <!-- Email Input -->
            <div class="space-y-2 relative">
              <label
                for="email"
                class="block text-sm font-semibold text-slate-700"
                >Correo Electrónico</label
              >
              <input
                type="email"
                id="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/15 outline-none transition-all text-slate-800"
                placeholder="juan@empresa.com"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Phone Input -->
            <div class="space-y-2">
              <label
                for="phone"
                class="block text-sm font-semibold text-slate-700"
                >Número de Teléfono</label
              >
              <input
                type="tel"
                id="phone"
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/15 outline-none transition-all text-slate-800"
                placeholder="300 123 4567"
              />
            </div>

            <!-- Category / Product of interest -->
            <div class="space-y-2">
              <label
                for="product-line"
                class="block text-sm font-semibold text-slate-700"
                >Línea de Interés</label
              >
              <select
                id="product-line"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/15 outline-none bg-white transition-all text-slate-800"
              >
                <option value="hogar"
                  >Línea Hogar (Detergentes, Lavavajillas)</option
                >
                <option value="institucional"
                  >Línea Institucional (Desengrasantes, Jabón manos)</option
                >
                <option value="desinfeccion"
                  >Desinfección (Amonio cuaternario, Alcohol)</option
                >
                <option value="automotriz"
                  >Línea Automotriz (Shampoo carros)</option
                >
                <option value="distribuidor"
                  >Quiero ser Distribuidor Autorizado</option
                >
              </select>
            </div>
          </div>

          <!-- Message Input -->
          <div class="space-y-2">
            <label
              for="message"
              class="block text-sm font-semibold text-slate-700"
              >Mensaje o Detalle del Pedido</label
            >
            <textarea
              id="message"
              rows="4"
              required
              class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/15 outline-none transition-all text-slate-800 resize-none"
              placeholder="Indícanos los productos y cantidades que deseas cotizar..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full py-4 rounded-xl text-white font-semibold bg-brand-blue hover:bg-brand-blue-dark transition-all duration-300 shadow-md shadow-brand-blue/10 hover:shadow-lg flex items-center justify-center space-x-2"
          >
            <span>Enviar Solicitud de Cotización</span>
            <!-- Loading Spinner (hidden by default) -->
            <svg
              id="submit-spinner"
              class="hidden animate-spin ml-2 h-5 w-5 text-white"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
          </button>
        </form>

        <!-- Success View (hidden by default) -->
        <div
          id="form-success"
          class="hidden absolute inset-0 text-center p-8 bg-white rounded-3xl animate-fade-in-up"
        >
          <div
            class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-8 h-8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4.5 12.75l6 6 9-13.5"></path>
            </svg>
          </div>

          <h3 class="font-display font-extrabold text-2xl text-brand-blue mb-2">
            ¡Solicitud Recibida!
          </h3>
          <p class="text-slate-500 text-sm max-w-sm mb-6">
            Gracias por contactarnos. Un asesor de <strong
              class="font-semibold text-brand-blue">Solar Fire S.A.S.</strong
            > se pondrá en contacto contigo en menos de 24 horas hábiles.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 w-full max-w-md">
            <button
              id="reset-form-btn"
              class="w-full sm:w-1/2 py-3 border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold rounded-xl transition-all"
            >
              Enviar otro mensaje
            </button>
            <a
              id="success-whatsapp-btn"
              href="#"
              target="_blank"
              class="w-full sm:w-1/2 py-3 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-xl flex items-center justify-center space-x-2 transition-all"
            >
              <span>Hablar por WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const successState = document.getElementById(
    "form-success",
  ) as HTMLDivElement;
  const spinner = document.getElementById("submit-spinner") as SVGSVGElement;
  const resetBtn = document.getElementById("reset-form-btn");
  const successWhatsappBtn = document.getElementById(
    "success-whatsapp-btn",
  ) as HTMLAnchorElement;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    // Show spinner
    spinner.classList.remove("hidden");

    // Get input values
    const name = (document.getElementById("name") as HTMLInputElement).value;
    const email = (document.getElementById("email") as HTMLInputElement).value;
    const phone = (document.getElementById("phone") as HTMLInputElement).value;
    const line = (document.getElementById("product-line") as HTMLSelectElement)
      .value;
    const message = (document.getElementById("message") as HTMLTextAreaElement)
      .value;

    // Simulate sending data (1.5 seconds)
    setTimeout(() => {
      // Hide spinner
      spinner.classList.add("hidden");

      // Hide form contents dynamically
      form.style.opacity = "0";

      setTimeout(() => {
        form.classList.add("hidden");
        successState.classList.remove("hidden");
        successState.classList.add(
          "flex",
          "flex-col",
          "items-center",
          "justify-center",
        );

        // Setup direct custom message on WhatsApp button in success screen
        const customText = `Hola Solar Fire, mi nombre es ${name}. He enviado una cotización de la línea ${line} por la página web. Mi cel es ${phone} y mi consulta es: ${message}`;
        successWhatsappBtn.href = `https://wa.me/573023716599?text=${encodeURIComponent(customText)}`;
      }, 300);
    }, 1500);
  });

  resetBtn?.addEventListener("click", () => {
    // Reset inputs
    form.reset();

    // Switch views back
    successState.classList.add("hidden");
    successState.classList.remove(
      "flex",
      "flex-col",
      "items-center",
      "justify-center",
    );
    form.classList.remove("hidden");
    setTimeout(() => {
      form.style.opacity = "1";
    }, 50);
  });
</script>
