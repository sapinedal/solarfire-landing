---
// Hero.astro
---

<section
  id="inicio"
  class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-linear-to-b from-blue-50/60 via-slate-50/30 to-white text-slate-800"
>
  <!-- Dynamic Gradient Background & Patterns -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,var(--tw-gradient-stops))] from-blue-100/30 via-slate-50/50 to-white pointer-events-none"
  >
  </div>

  <!-- Subtle pattern overlay -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,#00000003_1px,transparent_1px),linear-gradient(to_bottom,#00000003_1px,transparent_1px)] bg-size-[4rem_4rem] pointer-events-none"
  >
  </div>

  <!-- Decorative blur circles -->
  <div
    class="absolute -top-40 -right-40 w-[500px] h-[500px] bg-brand-yellow/15 rounded-full blur-3xl pointer-events-none"
  >
  </div>
  <div
    class="absolute top-1/2 -left-40 w-[400px] h-[400px] bg-brand-blue/5 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 items-center">
      <!-- Text content -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        <h1
          class="font-display font-extrabold text-4xl sm:text-5xl md:text-6xl text-brand-blue tracking-tight leading-none"
        >
          Poder de Limpieza que <br class="hidden sm:inline" />
          <span class="text-gradient-fire font-black">Transforma </span>
          <span class="text-brand-blue font-black">tus Espacios</span>
        </h1>

        <p
          class="text-lg md:text-xl text-slate-600 font-light max-w-2xl mx-auto lg:mx-0 leading-relaxed"
        >
          Fabricantes líderes de productos de aseo, desinfección y limpieza en <strong
            class="font-semibold text-brand-blue">Itagüí, Antioquia</strong
          >. Fórmulas de alta concentración certificadas por <strong
            class="font-semibold text-brand-blue">INVIMA</strong
          >, diseñadas para el cuidado total de tus superficies y la salud de tu
          familia o empresa.
        </p>

        <!-- CTAs -->
        <div
          class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4"
        >
          <a
            href="#contacto"
            class="w-full sm:w-auto relative group overflow-hidden px-8 py-4 rounded-2xl bg-brand-red text-white font-bold text-center transition-all duration-300 shadow-lg shadow-brand-red/20 hover:shadow-brand-red/40 hover:-translate-y-0.5 active:translate-y-0"
          >
            <!-- Sweep light effect -->
            <span
              class="absolute inset-0 w-full h-full bg-linear-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-out"
            ></span>
            Solicitar Cotización
          </a>

          <a
            href="#productos"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 hover:text-brand-blue font-semibold text-center transition-all duration-200 flex items-center justify-center space-x-2 shadow-xs"
          >
            <span>Ver Catálogo</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>

        <!-- Micro stats / Highlights -->
        <div
          class="grid grid-cols-3 gap-6 pt-6 border-t border-slate-100 max-w-lg mx-auto lg:mx-0 text-left"
        >
          <div>
            <div class="text-3xl font-bold font-display text-brand-red">
              100%
            </div>
            <div class="text-xs text-slate-500 uppercase tracking-widest mt-1">
              INVIMA Certificado
            </div>
          </div>
          <div>
            <div class="text-3xl font-bold font-display text-brand-orange">
              Bio
            </div>
            <div class="text-xs text-slate-500 uppercase tracking-widest mt-1">
              Biodegradables
            </div>
          </div>
          <div>
            <div class="text-3xl font-bold font-display text-brand-blue">
              Itagüí
            </div>
            <div class="text-xs text-slate-500 uppercase tracking-widest mt-1">
              Sede Antioquia
            </div>
          </div>
        </div>
      </div>

      <!-- Graphical placeholder product representation -->
      <div class="mt-16 lg:mt-0 lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-[480px]">
          <!-- Glow behind mockup -->
          <div
            class="absolute -inset-4 bg-linear-to-tr from-brand-red/10 to-brand-blue/10 rounded-3xl blur-3xl opacity-60"
          >
          </div>

          <!-- Mockup placeholder container -->
          <div
            class="relative bg-white p-3.5 rounded-3xl border border-slate-100 shadow-2xl flex flex-col items-center"
          >
            <img
              src="https://placehold.co/600x500/f0f4ff/1c3d5a?text=Gama+de+Productos+Solar+Fire+600x500"
              alt="Gama de Productos Solar Fire"
              class="w-full h-auto rounded-2xl object-cover shadow-sm bg-slate-100"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
