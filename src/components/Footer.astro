---
// Footer.astro
import { Image } from 'astro:assets';
import logoImage from '../assets/logo-solar-fire.png';
import { whatsappLink, WHATSAPP_DISPLAY } from '../data/products';
const currentYear = new Date().getFullYear();
---

<footer class="bg-ink text-slate-400 py-16 relative overflow-hidden">
  <!-- Decorative glow -->
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-brand-blue/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      
      <!-- Column 1: Brand description -->
      <div class="md:col-span-5 space-y-6">
        <a href="#inicio" class="flex items-center group">
          <span class="inline-flex rounded-2xl bg-white px-4 py-3">
            <Image src={logoImage} alt="Solar Fire" width={160} class="h-10 w-auto" />
          </span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
          <strong class="font-semibold text-slate-200">Solar Fire S.A.S.</strong> es un fabricante colombiano de productos químicos de limpieza, higiene y desinfección doméstica e industrial. Comprometidos con el desarrollo sostenible y la bioseguridad del país.
        </p>
        <p class="text-xs text-slate-500">
          Concepto sanitario y capacidad de fabricación avalada por el <strong class="font-semibold text-slate-200">INVIMA</strong>.
        </p>
      </div>

      <!-- Column 2: Navigation Links -->
      <div class="md:col-span-3 space-y-4">
        <h2 class="text-white font-bold text-sm uppercase tracking-wider">Enlaces rápidos</h2>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#inicio" class="hover:text-white transition-colors">Inicio</a></li>
          <li><a href="#productos" class="hover:text-white transition-colors">Catálogo de productos</a></li>
          <li><a href="#aromas" class="hover:text-white transition-colors">Limpia Pisos 3 en 1</a></li>
          <li><a href="#demostraciones" class="hover:text-white transition-colors">Línea RUDO en video</a></li>
          <li><a href="#nosotros" class="hover:text-white transition-colors">Nosotros & INVIMA</a></li>
          <li><a href="#contacto" class="hover:text-white transition-colors">Contacto / Cotizar</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact details & Instagram link -->
      <div class="md:col-span-4 space-y-4">
        <h2 class="text-white font-bold text-sm uppercase tracking-wider">Contacto & redes</h2>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-center space-x-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-brand-orange">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>Itagüí, Antioquia - Colombia</span>
          </li>
          <li class="flex items-center space-x-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-brand-orange">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.184-4.162-6.986-6.986l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>{WHATSAPP_DISPLAY} / (604) 374 8132</span>
          </li>
        </ul>

        <!-- Social Icons -->
        <div class="flex items-center space-x-4 pt-4">
          <!-- Instagram -->
          <a 
            href="https://www.instagram.com/solarfire.com.co/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:bg-brand-red transition-all duration-300"
            aria-label="Instagram Solar Fire"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <!-- WhatsApp -->
          <a 
            href={whatsappLink("")} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:bg-emerald-500 transition-all duration-300"
            aria-label="WhatsApp Solar Fire"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom copyright -->
    <div class="mt-12 pt-8 border-t border-white/10 text-center text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>&copy; {currentYear} Solar Fire S.A.S. Todos los derechos reservados.</p>
      <div class="flex items-center space-x-4">
        <span>Itagüí, Antioquia</span>
        <span>&bull;</span>
        <span>Fabricado en Colombia</span>
      </div>
    </div>
  </div>
</footer>
