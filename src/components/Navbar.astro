---
// Navbar.astro
import { Image } from "astro:assets";
import logoImage from "../assets/logo-solar-fire.png";
import { whatsappLink } from "../data/products";

const links = [
  { href: "#productos", label: "Productos" },
  { href: "#aromas", label: "Limpia Pisos" },
  { href: "#demostraciones", label: "Línea RUDO" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#contacto", label: "Contacto" },
];
const quoteHref = whatsappLink("Hola Solar Fire, vengo de la página web y quiero cotizar productos.");
---

<header id="main-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav
      id="main-nav"
      class="mt-4 flex items-center justify-between rounded-2xl px-4 sm:px-6 py-3 bg-white/85 backdrop-blur-md border border-cream-dark transition-shadow duration-300"
      aria-label="Principal"
    >
      <a href="#inicio" class="flex items-center shrink-0" aria-label="Solar Fire, ir al inicio">
        <Image src={logoImage} alt="Solar Fire" width={160} class="h-10 sm:h-11 w-auto" loading="eager" />
      </a>

      <div class="hidden lg:flex items-center gap-1">
        {links.map((l) => (
          <a
            href={l.href}
            class="nav-link px-3.5 py-2 rounded-lg text-[15px] font-medium text-slate-600 hover:text-brand-blue hover:bg-cream transition-colors"
          >
            {l.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <a
          href={quoteHref}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white text-sm font-semibold transition-colors"
        >
          Cotizar ahora
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-lg text-ink hover:bg-cream transition-colors"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </nav>

    <div
      id="mobile-menu"
      class="hidden lg:hidden mt-2 rounded-2xl bg-white border border-cream-dark shadow-xl p-4 animate-fade-in-up"
    >
      <div class="flex flex-col">
        {links.map((l) => (
          <a href={l.href} class="mobile-link px-3 py-3 rounded-lg font-semibold text-lg text-ink hover:bg-cream">
            {l.label}
          </a>
        ))}
        <a
          href={quoteHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-link mt-2 inline-flex justify-center px-5 py-3 rounded-xl bg-brand-red text-white font-semibold"
        >
          Cotizar ahora
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById("main-nav");
  const onScroll = () => {
    nav?.classList.toggle("shadow-lg", window.scrollY > 20);
    nav?.classList.toggle("shadow-ink/5", window.scrollY > 20);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  const setMenu = (open: boolean) => {
    mobileMenu?.classList.toggle("hidden", !open);
    menuBtn?.setAttribute("aria-expanded", String(open));
  };

  menuBtn?.addEventListener("click", () => setMenu(mobileMenu?.classList.contains("hidden") ?? false));
  document.querySelectorAll(".mobile-link").forEach((link) => link.addEventListener("click", () => setMenu(false)));
</script>
