---
// VideoSection.astro - Showcase de demostraciones en video reales
interface VideoItem {
  id: string;
  title: string;
  subtitle: string;
  tag: string;
  videoSrc: string;
  posterSrc: string;
  category: string;
  benefits: string[];
  whatsappMessage: string;
}

const videos: VideoItem[] = [
  {
    id: "video-juntas",
    title: "RUDO Limpiador de Juntas",
    subtitle: "Acción penetrante que disuelve sarro, hongos y mugre acumulada en juntas de baldosas al instante.",
    tag: "Pisos & Juntas",
    videoSrc: "/video-1.mp4",
    posterSrc: "/video-1-poster.webp",
    category: "Línea RUDO",
    benefits: ["Espuma activa instantánea", "Sin dañar el esmalte de la baldosa", "Fácil aplicación directa"],
    whatsappMessage: "Hola Solar Fire, vi el video del Limpiador de Juntas RUDO y deseo cotizarlo."
  },
  {
    id: "video-alcalino",
    title: "RUDO Desincrustante Alcalino",
    subtitle: "Fórmula Nivel 4 de máxima potencia para devolver el brillo original a superficies metálicas y acero.",
    tag: "Acero Inoxidable",
    videoSrc: "/video-2.mp4",
    posterSrc: "/video-2-poster.webp",
    category: "Nivel 4 Máxima Potencia",
    benefits: ["Arranca óxido y quemaduras", "Brillo espejo en acero inoxidable", "Alto rendimiento concentrado"],
    whatsappMessage: "Hola Solar Fire, vi el video del Desincrustante Alcalino RUDO Nivel 4 y deseo cotizarlo."
  },
  {
    id: "video-desengrasante",
    title: "RUDO Desengrasante Pesado",
    subtitle: "Desprende grasa adherida y aceites industriales en aspas, campanas extractoras y maquinaria.",
    tag: "Desengrase Extremo",
    videoSrc: "/video-3.mp4",
    posterSrc: "/video-3-poster.webp",
    category: "Uso Industrial & Taller",
    benefits: ["Disuelve grasa carbonizada", "Rápida acción por aspersión", "Apto para campanas y motores"],
    whatsappMessage: "Hola Solar Fire, vi el video del Desengrasante Pesado RUDO y deseo solicitar una cotización."
  }
];
---

<section id="demostraciones" class="py-20 md:py-28 bg-brand-blue-dark text-white relative overflow-hidden">
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[60rem] h-[30rem] bg-brand-blue/60 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="reveal flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <p class="eyebrow text-brand-sun!">Línea RUDO · Uso profesional</p>
        <h2 class="mt-3 font-display font-extrabold text-4xl md:text-5xl tracking-tight leading-[1.05]">
          Míralo funcionar, sin trucos
        </h2>
      </div>
      <p class="max-w-md text-white/70 leading-relaxed">
        Pruebas reales de nuestra línea especializada <strong class="text-white">RUDO</strong> en juntas, acero inoxidable y grasa industrial.
      </p>
    </div>

    <!-- Video Showcase Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {videos.map((item, index) => (
        <div class="video-showcase-card reveal flex flex-col bg-white text-ink rounded-3xl overflow-hidden shadow-2xl shadow-black/30 group">
          
          <!-- Video Frame / Player Container -->
          <div class="relative w-full aspect-9/16 bg-slate-900 overflow-hidden cursor-pointer select-none">
            
            <!-- Native HTML5 Video with fast-start web optimization -->
            <video
              id={item.id}
              class="video-player w-full h-full object-cover"
              src={item.videoSrc}
              poster={item.posterSrc}
              preload="metadata"
              playsinline
              loop
            >
              <source src={item.videoSrc} type="video/mp4" />
              Tu navegador no soporta reproducción de video HTML5.
            </video>

            <!-- Top Overlay Badge -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none z-20">
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md text-white border border-white/20">
                {item.tag}
              </span>
            </div>

            <!-- Big Central Play/Pause Indicator -->
            <div class="play-overlay absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/20 transition-all duration-300 z-15">
              <button 
                type="button" 
                class="play-btn w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-brand-red/90 text-white flex items-center justify-center shadow-2xl backdrop-blur-xs transform transition-transform duration-300 hover:scale-110 active:scale-95 border-2 border-white/40"
                aria-label={`Reproducir demostración de ${item.title}`}
              >
                <!-- Play Icon -->
                <svg class="play-icon w-8 h-8 sm:w-10 sm:h-10 ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
                <!-- Pause Icon (hidden by default) -->
                <svg class="pause-icon w-8 h-8 sm:w-10 sm:h-10 hidden" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                </svg>
              </button>
            </div>

            <!-- Bottom Floating Quick Controls Bar -->
            <div class="absolute bottom-0 inset-x-0 p-4 bg-linear-to-t from-black/80 via-black/40 to-transparent flex items-center justify-between text-white z-20 transition-opacity duration-300">
              
              <!-- Progress bar container -->
              <div class="absolute top-0 inset-x-0 h-1 bg-white/20 cursor-pointer video-progress-container">
                <div class="video-progress-bar h-full bg-brand-yellow w-0 transition-all duration-100"></div>
              </div>

              <!-- Status / Time hint -->
              <span class="video-status text-xs font-semibold text-white/90 drop-shadow">
                Toca para reproducir
              </span>

              <!-- Sound Toggle & Fullscreen Buttons -->
              <div class="flex items-center space-x-2">
                <!-- Sound Toggle Button -->
                <button 
                  type="button" 
                  class="sound-btn p-2 rounded-full bg-black/50 hover:bg-black/70 backdrop-blur-sm text-white border border-white/20 transition-transform active:scale-90"
                  aria-label="Silenciar / Activar sonido"
                >
                  <!-- Volume Muted Icon -->
                  <svg class="volume-muted-icon w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.757 3.63 8.25 4.51 8.25H6.75z" />
                  </svg>
                  <!-- Volume High Icon -->
                  <svg class="volume-high-icon w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.757 3.63 8.25 4.51 8.25H6.75z" />
                  </svg>
                </button>

                <!-- Fullscreen Button -->
                <button 
                  type="button" 
                  class="fullscreen-btn p-2 rounded-full bg-black/50 hover:bg-black/70 backdrop-blur-sm text-white border border-white/20 transition-transform active:scale-90"
                  aria-label="Pantalla completa"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                  </svg>
                </button>
              </div>

            </div>

          </div>

          <!-- Video Details and Direct Conversion CTA -->
          <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
            <div class="space-y-2">
              <span class="text-[11px] font-bold text-brand-orange uppercase tracking-wider block">
                {item.category}
              </span>
              <h3 class="font-display font-bold text-xl text-brand-blue">
                {item.title}
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                {item.subtitle}
              </p>

              <!-- Feature bullets -->
              <ul class="pt-2 space-y-1.5 text-xs text-slate-500">
                {item.benefits.map((benefit) => (
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action Button -->
            <div class="pt-2">
              <a
                href={`https://wa.me/573023716599?text=${encodeURIComponent(item.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center space-x-2 px-5 py-3 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white font-semibold text-sm transition-colors"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/>
                </svg>
                <span>Cotizar Este Producto</span>
              </a>
            </div>

          </div>

        </div>
      ))}
    </div>

    <!-- Quality Assurance Callout under videos -->
    <div class="reveal mt-14 p-6 sm:p-8 rounded-3xl bg-white/5 border border-white/10 text-white flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center shrink-0 border border-white/20">
          <svg class="w-8 h-8 text-brand-yellow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
        <div>
          <h3 class="font-display font-bold text-lg sm:text-xl text-white">¿Necesitas asesoría técnica para tu empresa?</h3>
          <p class="text-white/70 text-sm mt-0.5">Te enviamos fichas técnicas y te ayudamos a elegir el producto ideal.</p>
        </div>
      </div>
      <a 
        href="#contacto" 
        class="shrink-0 px-8 py-3.5 rounded-xl bg-brand-sun hover:bg-brand-yellow text-ink font-semibold transition-colors"
      >
        Hablar con un Especialista
      </a>
    </div>

  </div>
</section>

<script>
  // Advanced Multi-Video Controller with smooth UX
  const cards = document.querySelectorAll(".video-showcase-card");
  const allVideos = document.querySelectorAll<HTMLVideoElement>(".video-player");

  cards.forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>(".video-player");
    const playOverlay = card.querySelector<HTMLDivElement>(".play-overlay");
    const playBtn = card.querySelector<HTMLButtonElement>(".play-btn");
    const playIcon = card.querySelector<SVGElement>(".play-icon");
    const pauseIcon = card.querySelector<SVGElement>(".pause-icon");
    const soundBtn = card.querySelector<HTMLButtonElement>(".sound-btn");
    const volumeHighIcon = card.querySelector<SVGElement>(".volume-high-icon");
    const volumeMutedIcon = card.querySelector<SVGElement>(".volume-muted-icon");
    const fullscreenBtn = card.querySelector<HTMLButtonElement>(".fullscreen-btn");
    const progressBar = card.querySelector<HTMLDivElement>(".video-progress-bar");
    const progressContainer = card.querySelector<HTMLDivElement>(".video-progress-container");
    const statusText = card.querySelector<HTMLSpanElement>(".video-status");

    if (!video) return;

    // Toggle Play / Pause function
    const togglePlay = () => {
      if (video.paused) {
        // Pause any other playing video so sounds don't overlap
        allVideos.forEach((v) => {
          if (v !== video && !v.paused) {
            v.pause();
          }
        });

        video.play().catch(() => {
          // Autoplay policy fallback: mute and play
          video.muted = true;
          updateSoundUI(true);
          video.play();
        });
      } else {
        video.pause();
      }
    };

    // Update UI on Play
    video.addEventListener("play", () => {
      playIcon?.classList.add("hidden");
      pauseIcon?.classList.remove("hidden");
      playOverlay?.classList.add("opacity-0", "pointer-events-none");
      if (statusText) statusText.textContent = "Reproduciendo";
    });

    // Update UI on Pause
    video.addEventListener("pause", () => {
      pauseIcon?.classList.add("hidden");
      playIcon?.classList.remove("hidden");
      playOverlay?.classList.remove("opacity-0", "pointer-events-none");
      if (statusText) statusText.textContent = "Pausado";
    });

    // Update Progress bar as video plays
    video.addEventListener("timeupdate", () => {
      if (video.duration && progressBar) {
        const percent = (video.currentTime / video.duration) * 100;
        progressBar.style.width = `${percent}%`;
      }
    });

    // Reset on Ended
    video.addEventListener("ended", () => {
      if (progressBar) progressBar.style.width = "0%";
      pauseIcon?.classList.add("hidden");
      playIcon?.classList.remove("hidden");
      playOverlay?.classList.remove("opacity-0", "pointer-events-none");
      if (statusText) statusText.textContent = "Completado";
    });

    // Click on video area to toggle playback
    const videoContainer = card.querySelector<HTMLDivElement>(".aspect-9\\/16");
    videoContainer?.addEventListener("click", (e) => {
      // Ignore clicks on control buttons to prevent double toggling
      if ((e.target as HTMLElement).closest(".sound-btn, .fullscreen-btn, .video-progress-container")) {
        return;
      }
      togglePlay();
    });

    // Sound Toggle handler
    const updateSoundUI = (isMuted: boolean) => {
      if (isMuted) {
        volumeHighIcon?.classList.add("hidden");
        volumeMutedIcon?.classList.remove("hidden");
      } else {
        volumeMutedIcon?.classList.add("hidden");
        volumeHighIcon?.classList.remove("hidden");
      }
    };

    soundBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      video.muted = !video.muted;
      updateSoundUI(video.muted);
    });

    // Fullscreen toggle handler
    fullscreenBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (!document.fullscreenElement) {
        if (video.requestFullscreen) {
          video.requestFullscreen();
        } else if ((video as any).webkitRequestFullscreen) {
          (video as any).webkitRequestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    });

    // Seek on progress bar click
    progressContainer?.addEventListener("click", (e) => {
      e.stopPropagation();
      const rect = progressContainer.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const width = rect.width;
      if (video.duration) {
        video.currentTime = (clickX / width) * video.duration;
      }
    });
  });
</script>

<style>
  /* Aspect ratio support */
  .aspect-9\/16 {
    aspect-ratio: 9 / 16;
  }
</style>
