---
// ProductDialog.astro — ficha completa del producto en un <dialog> nativo
import { Image } from "astro:assets";
import type { Product } from "../data/products";
import { whatsappLink } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const check = "M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z";
---

<dialog
  id={`ficha-${product.slug}`}
  class="product-dialog m-auto w-[min(64rem,calc(100%-1.5rem))] max-h-[calc(100dvh-1.5rem)] overflow-y-auto overscroll-contain rounded-3xl bg-white p-0 text-ink shadow-2xl backdrop:bg-ink/60 backdrop:backdrop-blur-sm"
  aria-labelledby={`ficha-${product.slug}-title`}
>
  <div class="grid md:grid-cols-2">
    <!-- Gallery -->
    <div class="relative bg-white md:sticky md:top-0 md:self-start p-6 sm:p-8 md:border-r border-cream-dark">
      <div class="relative aspect-square">
        <div class="absolute inset-8 sun-glow" aria-hidden="true"></div>
        {product.images.map((img, i) => (
          <Image
            src={img.src}
            alt={img.alt}
            widths={[320, 480, 640, 900]}
            sizes="(min-width: 768px) 480px, 90vw"
            loading="lazy"
            data-gallery-main={i}
            class:list={["absolute inset-0 w-full h-full object-contain mix-blend-multiply transition-opacity duration-300", i !== 0 && "opacity-0"]}
          />
        ))}
      </div>
      {product.images.length > 1 && (
        <div class="mt-4 flex justify-center gap-2">
          {product.images.map((img, i) => (
            <button
              type="button"
              data-gallery-thumb={i}
              aria-label={`Ver foto ${i + 1}`}
              aria-pressed={i === 0 ? "true" : "false"}
              class="w-16 h-16 rounded-xl border-2 border-transparent aria-pressed:border-brand-blue bg-white p-1 overflow-hidden transition-colors"
            >
              <Image src={img.src} alt="" width={128} class="w-full h-full object-contain" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Details -->
    <div class="p-6 sm:p-8 space-y-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="eyebrow">{product.categories.join(" · ")}</p>
          <h3 id={`ficha-${product.slug}-title`} class="mt-2 font-display font-extrabold text-3xl text-brand-blue leading-tight">
            {product.name}
          </h3>
        </div>
        <form method="dialog">
          <button class="p-2 -m-2 rounded-full text-slate-500 hover:bg-cream hover:text-ink" aria-label="Cerrar ficha">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </form>
      </div>

      <div class="space-y-3 text-[15px] text-slate-600 leading-relaxed">
        {product.description.map((p) => <p>{p}</p>)}
      </div>

      {product.variants && (
        <div>
          <h4 class="text-sm font-bold text-ink mb-2">{product.variants.label}</h4>
          <ul class="flex flex-wrap gap-2">
            {product.variants.items.map((v) => (
              <li class="px-3 py-1.5 rounded-lg bg-cream border border-cream-dark text-sm font-medium">{v}</li>
            ))}
          </ul>
        </div>
      )}

      {product.benefits && (
        <div>
          <h4 class="text-sm font-bold text-ink mb-2">Beneficios</h4>
          <ul class="space-y-1.5">
            {product.benefits.map((b) => (
              <li class="flex gap-2 text-sm text-slate-600">
                <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 mt-0.5 shrink-0 text-brand-orange" aria-hidden="true"><path fill-rule="evenodd" d={check} clip-rule="evenodd" /></svg>
                {b}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div>
        <h4 class="text-sm font-bold text-ink mb-2">Aplicaciones</h4>
        <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-1.5">
          {product.applications.map((a) => (
            <li class="flex gap-2 text-sm text-slate-600">
              <span class="w-1.5 h-1.5 mt-2 rounded-full bg-brand-blue shrink-0" aria-hidden="true"></span>
              {a}
            </li>
          ))}
        </ul>
      </div>

      {product.usage && (
        <div class="rounded-2xl bg-brand-blue-light p-4">
          <h4 class="text-sm font-bold text-brand-blue mb-1">Modo de uso</h4>
          <p class="text-sm text-slate-600">{product.usage}</p>
        </div>
      )}

      <blockquote class="border-l-4 border-brand-sun pl-4 font-display text-lg text-ink italic">
        “{product.quote}”
      </blockquote>

      <a
        href={whatsappLink(`Hola Solar Fire, vi la ficha del producto ${product.name} en la página web y quiero cotizarlo.`)}
        target="_blank"
        rel="noopener noreferrer"
        class="flex w-full items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-brand-red hover:bg-brand-red-dark text-white font-semibold transition-colors"
      >
        Cotizar {product.name} por WhatsApp
      </a>
      <p class="text-xs text-slate-400">
        Mantener fuera del alcance de los niños. Usar siguiendo las indicaciones de la etiqueta.
      </p>
    </div>
  </div>
</dialog>
