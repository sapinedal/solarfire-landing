---
// ProductSection.astro
import ProductCard from "./ProductCard.astro";
import ProductDialog from "./ProductDialog.astro";
import { products, categories } from "../data/products";

const filters = ["Todos", ...categories];
---

<section id="productos" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-12">
      <div class="max-w-2xl">
        <p class="eyebrow">Catálogo</p>
        <h2 class="mt-3 font-display font-extrabold text-4xl md:text-5xl text-brand-blue tracking-tight leading-[1.05]">
          Productos para cada rincón
        </h2>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Fórmulas concentradas para el hogar, la cocina y la industria, disponibles desde litro hasta bidón de 20 litros.
        </p>
      </div>

      <div class="flex flex-wrap lg:flex-nowrap lg:shrink-0 gap-2" role="group" aria-label="Filtrar por categoría">
        {filters.map((cat, idx) => (
          <button
            type="button"
            class="filter-btn px-5 py-2.5 rounded-full text-sm font-semibold border transition-colors aria-pressed:bg-brand-blue aria-pressed:text-white aria-pressed:border-brand-blue bg-white text-slate-600 border-cream-dark hover:border-brand-blue/40"
            data-filter={cat}
            aria-pressed={idx === 0 ? "true" : "false"}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </div>

  {products.map((product) => <ProductDialog product={product} />)}
</section>

<script>
  // Category filter
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".product-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;
      filterBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      cards.forEach((card) => {
        const cats = card.dataset.categories?.split("|") ?? [];
        card.hidden = filter !== "Todos" && !cats.includes(filter ?? "");
      });
    });
  });

  // Product detail dialogs
  document.querySelectorAll<HTMLElement>("[data-open-product]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const dialog = document.getElementById(`ficha-${trigger.dataset.openProduct}`) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>(".product-dialog").forEach((dialog) => {
    // Close when clicking on the backdrop
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Thumbnail gallery
    const mains = dialog.querySelectorAll<HTMLImageElement>("[data-gallery-main]");
    const thumbs = dialog.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]");
    mains.forEach((img, i) => img.setAttribute("aria-hidden", String(i !== 0)));
    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const idx = thumb.dataset.galleryThumb;
        mains.forEach((img) => {
          const active = img.dataset.galleryMain === idx;
          img.classList.toggle("opacity-0", !active);
          img.setAttribute("aria-hidden", String(!active));
        });
        thumbs.forEach((t) => t.setAttribute("aria-pressed", String(t === thumb)));
      });
    });
  });
</script>

<style>
  .product-card[hidden] {
    display: none;
  }
</style>
