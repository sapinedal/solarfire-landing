const categories = ["Todos", "Línea RUDO", "Hogar", "Institucional", "Desinfección", "Automotriz"];
---

<section id="productos" class="py-24 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-brand-yellow/20 border border-brand-yellow/30 text-brand-orange font-bold text-xs tracking-wider uppercase">
        <span>Catálogo de Soluciones</span>
      </div>
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-brand-blue tracking-tight leading-none">
        Nuestra Línea de <span class="text-gradient-fire">Productos</span>
      </h2>
      <p class="text-slate-600 text-lg leading-relaxed">
        Contamos con un portafolio diseñado para cubrir todas las necesidades de limpieza y desinfección, garantizando la máxima higiene en cada espacio.
      </p>
    </div>

    <!-- Filter Buttons Grid -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`filter-btn px-6 py-3 rounded-full text-sm font-semibold border transition-all duration-300 ${
            idx === 0
              ? "bg-brand-blue text-white border-brand-blue shadow-md shadow-brand-blue/10"
              : "bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100 hover:border-slate-300"
          }`}
          data-filter={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Products Grid Container -->
    <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {products.map((prod) => (
        <ProductCard {...prod} />
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-20">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-slate-300 mx-auto mb-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
      </svg>
      <h3 class="text-slate-700 font-semibold text-lg">No se encontraron productos</h3>
      <p class="text-slate-400 text-sm mt-1">Intenta seleccionando otra categoría.</p>
    </div>

  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll(".filter-btn");
  const productCards = document.querySelectorAll(".product-card") as NodeListOf<HTMLDivElement>;
  const emptyState = document.getElementById("empty-state");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      // 1. Update button classes
      filterBtns.forEach((b) => {
        b.classList.remove("bg-brand-blue", "text-white", "border-brand-blue", "shadow-md", "shadow-brand-blue/10");
        b.classList.add("bg-slate-50", "text-slate-600", "border-slate-200", "hover:bg-slate-100");
      });

      btn.classList.remove("bg-slate-50", "text-slate-600", "border-slate-200", "hover:bg-slate-100");
      btn.classList.add("bg-brand-blue", "text-white", "border-brand-blue", "shadow-md", "shadow-brand-blue/10");

      // 2. Filter products
      const selectedFilter = btn.getAttribute("data-filter");
      let visibleCount = 0;

      productCards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category");

        if (selectedFilter === "Todos" || cardCategory === selectedFilter) {
          card.classList.remove("hidden");
          card.style.opacity = "0";
          card.style.transform = "scale(0.95)";
          // Trigger browser layout flow to process transition
          setTimeout(() => {
            card.style.opacity = "1";
            card.style.transform = "scale(1)";
          }, 50);
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      // 3. Show/hide empty state
      if (visibleCount === 0) {
        emptyState?.classList.remove("hidden");
      } else {
        emptyState?.classList.add("hidden");
      }
    });
  });
</script>

<style>
  .product-card {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>
