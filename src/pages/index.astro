---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProductSection from '../components/ProductSection.astro';
import AromaShowcase from '../components/AromaShowcase.astro';
import VideoSection from '../components/VideoSection.astro';
import InvimaBadge from '../components/InvimaBadge.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />

  <main>
    <!-- Brand presentation -->
    <Hero />

    <!-- Filterable catalog with product detail dialogs -->
    <ProductSection />

    <!-- Featured product: Limpia Pisos aroma picker -->
    <AromaShowcase />

    <!-- Real video demonstrations (Línea RUDO) -->
    <VideoSection />

    <!-- About, INVIMA & Línea BIO -->
    <InvimaBadge />

    <!-- Quote form (opens WhatsApp) -->
    <ContactForm />
  </main>

  <Footer />
</Layout>
