---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import InvimaBadge from '../components/InvimaBadge.astro';
import ProductSection from '../components/ProductSection.astro';
import VideoSection from '../components/VideoSection.astro';
import CleaningSimulator from '../components/CleaningSimulator.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- Main Header -->
  <Navbar />
  
  <main>
    <!-- Hero Banner with core brand presentation -->
    <Hero />
    
    <!-- INVIMA & Quality Trust Section -->
    <InvimaBadge />
    
    <!-- Interactive Filterable Products Catalog -->
    <ProductSection />
    
    <!-- Real Video Demonstrations & RUDO Showcase -->
    <VideoSection />
    
    <!-- Interactive Before & After Simulator -->
    <CleaningSimulator />
    
    <!-- Professional Quote and Lead Form -->
    <ContactForm />
  </main>

  <!-- Corporate Footer -->
  <Footer />
</Layout>
